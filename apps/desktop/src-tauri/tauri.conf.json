{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artemis",
  "version": "0.0.0",
  "identifier": "dev.artemis.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:shell",
    "devUrl": "http://127.0.0.1:4637",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Artemis",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
