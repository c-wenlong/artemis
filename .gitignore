# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Rust / Tauri
target/
apps/desktop/src-tauri/gen/
# Intermediate raster generated from icon.svg by `tauri icon`; the desktop
# icons/ files are committed because the bundler needs them. Mobile icon sets
# are not — regenerate with `tauri icon` if Artemis ever targets them.
apps/desktop/src-tauri/icon.png
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/

# The scrubber's token list: the personal strings being removed from history.
# Committing it would publish exactly what it exists to delete.
scripts/scrub-tokens.txt

# Python bytecode
#
# Never commit this. A .pyc embeds every string constant of the module it was
# built from, and it is binary, so text-based audits look straight past it.
__pycache__/
*.pyc

# Environment
.env
.env.*
!.env.example

# Local data
*.sqlite
*.sqlite3
*.db

# Editor / OS
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
